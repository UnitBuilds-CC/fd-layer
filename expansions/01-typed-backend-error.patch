 #[test]
+fn backend_errors_are_typed_for_retry() {
+    // #5: retry policy is a *type*, not a string match. The fallible backend distinguishes a
+    // transient one-shot fault from a permanent failure via `BackendErrorKind`, and `is_transient`
+    // reflects exactly that.
+    wired!(proc, _mem, slow, fs);
+    let fd = proc.open(slow, READ).unwrap();
+
+    // WouldBlock: transient.
+    fs.faults().arm_would_block();
+    let e = proc.read(fd, &mut [0u8; 4]).unwrap_err();
+    assert!(matches!(e, Error::WouldBlock));
+    assert!(e.is_transient(), "WouldBlock must be reported retryable");
+
+    // The injected one-shot fault is now a *transient* backend failure, carried by `kind`.
+    fs.faults().arm_error();
+    let e = proc.read(fd, &mut [0u8; 4]).unwrap_err();
+    assert!(
+        matches!(
+            e,
+            Error::Backend {
+                kind: BackendErrorKind::Transient,
+                ..
+            }
+        ),
+        "a one-shot fault must carry the Transient kind, not just a message"
+    );
+    assert!(e.is_transient());
+
+    // The constructor default is permanent, and permanent must NOT read as retryable.
+    let perm = Error::backend("chunked", "gone for good");
+    assert!(matches!(
+        perm,
+        Error::Backend {
+            kind: BackendErrorKind::Permanent,
+            ..
+        }
+    ));
+    assert!(
+        !perm.is_transient(),
+        "permanent must not be reported retryable"
+    );
+}
