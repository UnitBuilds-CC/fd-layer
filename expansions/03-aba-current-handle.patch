+    /// Whether `ofd` is *still* the description occupying `fd` — the same `Arc`, not merely the
+    /// same file. This is the layer's ABA guard: a caller that captured an `Arc<OpenFileDescription>`
+    /// can ask, after a possible `close`, whether its handle refers to the live descriptor or to a
+    /// slot that was freed and re-opened (possibly to a different file) underneath it.
+    ///
+    /// The comparison is `Arc::ptr_eq` against the slot's current `Arc`, so it is exact and cheap.
+    /// Crucially it needs no generation counter in the guest-visible `u32` fd: the identity token is
+    /// the `Arc` the caller already holds, keeping the `type Fd = u32` journal contract intact.
+    pub fn is_current(&self, fd: RawFd, ofd: &Arc<OpenFileDescription>) -> bool {
+        self.lock_table()
+            .get(fd)
+            .is_some_and(|current| Arc::ptr_eq(&current, ofd))
+    }
