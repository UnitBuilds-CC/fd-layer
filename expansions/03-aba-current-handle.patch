 #[test]
+fn is_current_distinguishes_a_reused_slot_from_a_stale_handle() {
+    // ABA: close a descriptor and re-open the *same slot* (a different file). The numeric fd is
+    // identical, so a guest holding only the u32 cannot tell them apart — a caller holding the OFD
+    // `Arc` can, without any generation counter leaking into the journal-visible fd.
+    wired!(proc, mem, slow, _fs);
+    let fd = proc.open(mem, READ).unwrap();
+    let stale = proc.get(fd).unwrap();
+    assert!(
+        proc.is_current(fd, &stale),
+        "handle matches the live descriptor"
+    );
+
+    proc.close(fd).unwrap();
+    let fd_again = proc.open(slow, READ).unwrap();
+    assert_eq!(
+        fd_again, fd,
+        "the numeric slot is reused (the ABA aliasing)"
+    );
+    assert!(proc.is_open(fd), "slot is occupied again");
+    assert!(
+        !proc.is_current(fd, &stale),
+        "stale handle must NOT match the freshly-opened descriptor"
+    );
+
+    let fresh = proc.get(fd).unwrap();
+    assert!(
+        proc.is_current(fd, &fresh),
+        "the new handle matches the live descriptor"
+    );
+
+    proc.close(fd).unwrap();
+    assert!(
+        !proc.is_current(fd, &fresh),
+        "after close, even the once-live handle is no longer current"
+    );
+}
