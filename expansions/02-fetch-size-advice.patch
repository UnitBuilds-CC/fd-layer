 #[test]
+fn backend_advises_its_preferred_read_size() {
+    wired!(proc, mem, slow, _fs);
+    // The chunked backend caps every read at chunk_max (=8 in `wired_process`), so it advises 8 —
+    // a caller can size buffers to one natural unit without guessing or downcasting.
+    let fd_chunked = proc.open(slow, READ).unwrap();
+    assert_eq!(
+        proc.get(fd_chunked).unwrap().preferred_read_size(),
+        Some(8),
+        "a block-oriented backend reports its natural read unit"
+    );
+    // An in-memory backend has no preferred unit: any buffer is served as cheaply as the next.
+    let fd_mem = proc.open(mem, READ).unwrap();
+    assert_eq!(
+        proc.get(fd_mem).unwrap().preferred_read_size(),
+        None,
+        "an in-memory backend reports no preference"
+    );
+    // The advice is *not* a cap: a larger buffer is still served up to the backend's own real limit
+    // (chunk_max), so `read_at` governs the byte count and `preferred_read_size` only informs it.
+    let mut big = [0u8; 64];
+    let n = proc.read_at(fd_chunked, 0, &mut big).unwrap();
+    assert_eq!(
+        n, 8,
+        "read_at returns the backend's real chunk, not the advised size verbatim"
+    );
+}
